# Environment Configuration for Babul Portfolio Backend
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio_db?retryWrites=true&w=majority

# CORS Allowed Origins
CLIENT_URL=http://localhost:3000,https://babul-portfolio.vercel.app

# Email Service (Optional for Nodemailer notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=babulhossan.info@gmail.com
SMTP_PASS=your_app_password
RECIPIENT_EMAIL=babulhossan.info@gmail.com
